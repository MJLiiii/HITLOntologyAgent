# Local synthetic demonstration; no secrets are required.
OE_MODE=local
OE_DATA_DIR=.data
# Empty defaults to SQLite under OE_DATA_DIR.
OE_DATABASE_URL=
OE_EAGER_JOBS=false
# API and worker are separate; make demo enables the embedded worker.
OE_EMBEDDED_WORKER=false
# Team mode requires PostgreSQL and operator-created accounts.
# OE_MODE=team
# OE_TEAM_ORIGIN=https://studio.example.org
# For Mac loopback testing use http://127.0.0.1:5173 and this flag:
# OE_TEAM_ALLOW_INSECURE_LOOPBACK=true
# OE_SESSION_HOURS=12
# Model generation uses a private, project-authorized API profile registry.
# No model runtime or weights are installed by this project.
# See docs/multi-llm.md. Without a configured model, Studio uses the labelled demo.
# Optional service actor token; never put this in frontend configuration.
OE_SERVICE_TOKEN=
# Optional PostgreSQL development service (choose a private local password).
OE_POSTGRES_PASSWORD=
# OE_DATABASE_URL=postgresql+psycopg://ontology_studio:URL_ENCODED_PASSWORD@127.0.0.1:54329/ontology_studio
# Set only when runtimes are installed outside the documented defaults.
# OE_JAVA_EXECUTABLE=/absolute/path/to/java
# OE_JENA_RUNNER_JAR=/absolute/path/to/oe-jena-runner.jar
# OE_ONTOCHECK_PYTHON=/absolute/path/to/.venv-ontocheck/bin/python
# OE_ONTOCHECK_TIMEOUT_SECONDS=30
# Optional private server-side project bindings for selected TrustGraph corpus imports.
# See docs/trustgraph-import-contract.md; keep this JSON outside source control.
# OE_TRUSTGRAPH_CONFIG_FILE=/absolute/private/path/provider.json
# The following legacy environment fields serve the standalone gateway probes only.
# OE_TG_URL=http://127.0.0.1:8888
# OE_TG_WORKSPACE=synthetic-workspace
# OE_TG_FLOW=reviewed-flow
# OE_TG_COLLECTION=synthetic-collection
# OE_TG_TOKEN=
# OE_TG_LIVE_READONLY=1 enables the separately invoked read-only live contract probe.
# Optional project-allowlisted server-owned LLM profiles; frontend selects IDs only.
# Copy config/llm-profiles.example.json to a private location and replace project IDs.
# OE_LLM_CONFIG_FILE=/absolute/private/path/llm-profiles.json
# OE_LLM_DEFAULT_PROFILE=go-glm-flash
# Credential references are resolved from process environment, then this .env only.
# OPENCODE_API_KEY=   # configure privately; never paste a key into a tracked file
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Smoke only: Studio and every TrustGraph worker must share ONE physical SQLite file.
# Both paths must be absolute; see docs/multi-llm.md for bind mounts and price refresh.
# OE_LLM_SMOKE_BUDGET_FILE=/absolute/path/.runtime/multi-llm/smoke-budget.sqlite
# OE_LLM_SMOKE_PRICE_FILE=/absolute/path/.runtime/multi-llm/verified-prices.json
