# User service for this checkout; adjust the checkout path if installed elsewhere.
[Unit]
Description=Private local Ontology Studio API and production UI
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/projects/HITLOntologyAgent
EnvironmentFile=%h/projects/HITLOntologyAgent/.env
Environment=PYTHONPATH=services/api/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OE_EMBEDDED_WORKER=false
ExecStart=%h/projects/HITLOntologyAgent/.venv/bin/python -m uvicorn oe_studio.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers --timeout-graceful-shutdown 120
Restart=on-failure
RestartSec=5s
TimeoutStopSec=150s
KillMode=mixed
UMask=0077
MemoryHigh=1280M
MemoryMax=1536M
TasksMax=256

[Install]
WantedBy=default.target
