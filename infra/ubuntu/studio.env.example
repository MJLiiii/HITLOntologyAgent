# Install privately as /etc/ontology-studio/studio.env; this is not runnable as-is.
# Set both password values to the SAME private random hexadecimal password
# (hex avoids URL and Compose interpolation escaping). Never commit it.
OE_MODE=team
OE_DATABASE_URL=postgresql+psycopg://ontology_studio:REPLACE_WITH_PRIVATE_RANDOM_HEX@127.0.0.1:54329/ontology_studio
# Blank deliberately makes Compose refuse startup until configured.
OE_POSTGRES_PASSWORD=
OE_DATA_DIR=/var/lib/ontology-studio
OE_TEAM_ORIGIN=https://studio.example.invalid
OE_TEAM_ALLOW_INSECURE_LOOPBACK=false
OE_TEAM_TEST_SQLITE=false
OE_SESSION_HOURS=12
OE_EMBEDDED_WORKER=false
OE_EAGER_JOBS=false
OE_MAX_UPLOAD_BYTES=20971520
OE_ENGINE_ISOLATION=linux-bubblewrap
JAVA_HOME=/opt/ontology-studio/.runtime/java
OE_JAVA_EXECUTABLE=/opt/ontology-studio/.runtime/java/bin/java
OE_JENA_RUNNER_JAR=/opt/ontology-studio/services/jena-runner/target/oe-jena-runner.jar
OE_ONTOCHECK_PYTHON=/opt/ontology-studio/.venv-ontocheck/bin/python
OE_ONTOCHECK_TIMEOUT_SECONDS=20
# No model/provider registry means the labelled deterministic demo.
# Add server-owned model settings only after separate configuration/authorization.
# OE_LLM_CONFIG_FILE=/etc/ontology-studio/llm-profiles.json
# OE_LLM_DEFAULT_PROFILE=your-project-authorized-profile
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
